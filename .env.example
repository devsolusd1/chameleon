# ===== Server (NEVER expose these values) =====
# RPC used by the backend (Helius/QuickNode/Triton recommended for mainnet)
RPC_URL=https://api.mainnet-beta.solana.com
# Secret key (base58) of the wallet that is the token's UPDATE AUTHORITY
# (the same "creator" wallet used by the token creation script)
UPDATE_AUTHORITY_SECRET=
# USD value of tokens that must be burned to submit a change
# (the token amount is quoted live at burn time)
BURN_USD=50
# Cooldown between changes, in seconds
COOLDOWN_SECONDS=120
# Supply the token was created with (used to compute how much was burned)
INITIAL_SUPPLY=1000000000
# Fixed official website shown in the metadata (external_url) - never changes
SITE_URL=http://localhost:3000
# OPTIONAL Pinata (IPFS) mode: if set, each change pins image + JSON to IPFS
# and the on-chain URI is updated to the new CID
PINATA_JWT=
# Optional dedicated gateway domain (default: gateway.pinata.cloud)
PINATA_GATEWAY=
# Upstash Redis (state storage; required on Vercel, injected by the
# marketplace integration - KV_REST_API_URL/KV_REST_API_TOKEN also accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret required to call POST /api/republish (the 5-minute metadata touch)
REPUBLISH_SECRET=

# ===== Client (exposed in the browser) =====
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Token mint (fill in after running npm run create-token)
NEXT_PUBLIC_MINT_ADDRESS=
# Public URL of the site (used to build the fixed metadata URI)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# DexScreener pair (pool) address for the Chart links
NEXT_PUBLIC_DEX_PAIR=

# ===== Only for scripts/create-token.ts =====
CREATOR_SECRET=
TOKEN_NAME=Chameleon
TOKEN_SYMBOL=CHMLN
